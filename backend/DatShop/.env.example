# Spring Boot does not load .env files automatically.
#
# Option A — environment variables (recommended):
#   DB_URL, DB_USERNAME, DB_PASSWORD
#
# Option B — local file (gitignored), create next to pom.xml:
#   backend/DatShop/application-local.properties
#   Example contents:
#     spring.datasource.username=root
#     spring.datasource.password=YOUR_MYSQL_PASSWORD
#
# DB_URL=jdbc:mysql://localhost:3306/smart_fashion_shop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password_here
#
# JWT_SECRET must be Base64 and decode to at least 32 bytes. Do not commit a real secret.
# Generate one locally with a cryptographic RNG (do not use Get-Random).
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# Or put these keys in application-local.properties:
#   app.jwt.secret=YOUR_BASE64_SECRET
